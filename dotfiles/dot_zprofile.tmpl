# Login shells: macOS Homebrew only. Noninteractive jobs use mise exec explicitly.
if [[ $OSTYPE == darwin* ]]; then
    for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -x $brew_path ]]; then eval "$($brew_path shellenv)"; break; fi
    done
    unset brew_path
else
    typeset -U path
    path=( ${path:#*linuxbrew*} )
    path=( ${path:#*Linuxbrew*} )
fi
