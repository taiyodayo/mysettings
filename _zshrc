# ~/.zshrc — managed in ~/mysettings.
#   Source of truth: dotfiles/dot_zshrc.tmpl (chezmoi) and _zshrc (legacy copy
#   deployed by common/setup_zsh_and_keys.sh + automated/zsh_and_keys.yml).
#   The two files are byte-identical; edit one, copy to the other.
#   Runtime `[[ -d ... ]]` guards make one file work on Mac and Ubuntu.
#
# Per-machine additions do NOT go here:
#   ~/.zlocal        host-specific env, aliases, secrets loaders (sourced near the end)
#   ~/.zshrc.local   installer-added blocks you want to keep across re-kits (sourced last)
#
# Order matters: instant prompt → options → PATH → zinit/p10k → completions →
# tool hooks → aliases → ~/.zlocal → mise last (tools, per-dir [env], venv activation).

# ---------------------------------------------------------------------------
# powerlevel10k instant prompt. Must stay at the very top; nothing that reads
# stdin or prints may run before it.
# ---------------------------------------------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---------------------------------------------------------------------------
# History + shell options
# ---------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt append_history inc_append_history share_history extended_history
setopt hist_ignore_dups hist_ignore_space hist_reduce_blanks hist_verify
setopt interactivecomments  # `#` starts a comment on the command line (like bash)
setopt extended_glob        # ^ ~ # glob operators
setopt glob_dots            # globs match dotfiles (like bash)
setopt no_beep

# path/fpath are arrays tied to PATH/FPATH; -U keeps them duplicate-free so the
# prepends below can be repeated safely (re-source, nested shells, tmux, ...).
typeset -U path fpath manpath

export LANG=en_US.UTF-8     # ja_JP.UTF-8 breaks remote tools when iTerm2 forwards locale

# ---------------------------------------------------------------------------
# PATH. Order of these blocks = final precedence (later prepend wins).
# Every entry is guarded so the same file works on Mac / Ubuntu / a bare VM.
# ---------------------------------------------------------------------------

# Homebrew is a macOS dependency provider only.
if [[ $OSTYPE == darwin* ]]; then
    for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -x $_brew ]]; then eval "$($_brew shellenv)"; break; fi
    done
    unset _brew
else
    # Remove inherited stale Linuxbrew paths, without discarding project flags.
    path=( ${path:#*linuxbrew*} )
    path=( ${path:#*Linuxbrew*} )
fi
export HOMEBREW_AUTO_UPDATE_SECS=86400

# GNU coreutils/findutils/grep/sed/tar/getopt without the g- prefix (Mac only).
# USE_GNU_UTILS is also the guard string mac/setup_cli_tools.sh greps for.
if [[ $OSTYPE == darwin* && -n $HOMEBREW_PREFIX ]]; then
    for _gnu in coreutils findutils grep gnu-sed gnu-tar; do
        [[ -d $HOMEBREW_PREFIX/opt/$_gnu/libexec/gnubin ]] && path=("$HOMEBREW_PREFIX/opt/$_gnu/libexec/gnubin" $path)
    done
    [[ -d $HOMEBREW_PREFIX/opt/gnu-getopt/bin ]] && path=("$HOMEBREW_PREFIX/opt/gnu-getopt/bin" $path)
    [[ -d $HOMEBREW_PREFIX/opt/coreutils ]] && export USE_GNU_UTILS="true"
    unset _gnu
fi

# Rust selection and cargo PATH are provided by mise.

# Google Cloud SDK is mise-owned; no standalone SDK PATH injection.

# Android SDK (Mac; installed via Android Studio SDK Manager).
# 'Android/sdk/platform-tools' is the guard string mac/setup_cli_tools.sh greps for.
if [[ -d $HOME/Library/Android/sdk ]]; then
    export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
    [[ -d $ANDROID_SDK_ROOT/platform-tools ]]           && path=("$ANDROID_SDK_ROOT/platform-tools" $path)
    [[ -d $ANDROID_SDK_ROOT/cmdline-tools/latest/bin ]] && path=("$ANDROID_SDK_ROOT/cmdline-tools/latest/bin" $path)
fi

# Ruby, Flutter/bundled Dart, Bun and pnpm are selected by mise.
# Do not prepend FVM, standalone pnpm, Homebrew Ruby or global gem directories.

# mysettings custom CLI tools ('mysettings/cli_tools' is a kitting guard string).
[[ -d $HOME/mysettings/cli_tools ]] && path=("$HOME/mysettings/cli_tools" $path)
# mailab-internal command tools (appended: lowest precedence).
[[ -d $HOME/mailab-internal/misc/mailab_cmd_tools ]] && path+=("$HOME/mailab-internal/misc/mailab_cmd_tools")

# ~/.local/bin: native Claude Code, uv, pipx, and other user-installed tools.
path=("$HOME/.local/bin" $path)

# ---------------------------------------------------------------------------
# Cached prompt/plugins only: shell startup never clones or installs anything.
# Existing zinit directories remain usable; plugin maintenance is explicit.
# ---------------------------------------------------------------------------
POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
[[ ! -f $HOME/.zinit/plugins/romkatv---powerlevel10k/powerlevel10k.zsh-theme ]] || source "$HOME/.zinit/plugins/romkatv---powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -f $HOME/.p10k.zsh ]] || source "$HOME/.p10k.zsh"
autoload -Uz compinit
compinit -C
[[ ! -f $HOME/.zinit/plugins/zsh-users---zsh-autosuggestions/zsh-autosuggestions.zsh ]] || source "$HOME/.zinit/plugins/zsh-users---zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ ! -f $HOME/.zinit/plugins/zdharma-continuum---fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh ]] || source "$HOME/.zinit/plugins/zdharma-continuum---fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"

# Project Python environments are explicit: uv run / uv sync (no global venv).
# ---------------------------------------------------------------------------
# Aliases / functions
# ---------------------------------------------------------------------------
# ls colour: GNU ls (Linux, or Mac with coreutils on PATH) vs BSD ls.
if [[ $OSTYPE == darwin* && -z $USE_GNU_UTILS ]]; then
    alias ls='ls -G'
else
    alias ls='ls --color=auto'
fi
alias ff='flutter'
command -v uv  >/dev/null 2>&1 && alias pip='uv pip'

# Python comes from mise; uv run selects each project virtual environment.
# uvinit [py-version]: turn the current directory into a uv project
# (pyproject.toml + uv.lock + .venv). Add deps with `uv add`, never `pip install`.
uvinit() {
    [[ -f pyproject.toml ]] || uv init --bare --python "${1:-$(mise which python)}" || return 1
    uv sync || return 1
    echo "uv project ready in $PWD — run commands with uv run."
}

# mai研究室 docker-compose expects these (mailab-internal/docker/*). Uses zsh
# builtins ($HOST/$UID/$GID) so no subprocesses at startup.
export docker_host="$HOST" local_uid="$UID" local_gid="$GID" MAI_DEBUG="rstudio_gui"

# coatools @taiyodayo
[[ -f ~/.mailab/coatools/coatools.sh ]] && source ~/.mailab/coatools/coatools.sh

# ssh -A + tmux: keep SSH_AUTH_SOCK valid across re-attaches.
if [[ -n $TMUX && -S $SSH_AUTH_SOCK ]]; then
    mkdir -p ~/.ssh
    ln -sf "$SSH_AUTH_SOCK" ~/.ssh/ssh_auth_sock
    export SSH_AUTH_SOCK=~/.ssh/ssh_auth_sock
fi

# ---------------------------------------------------------------------------
# Per-machine config (not managed by the repo)
# ---------------------------------------------------------------------------
[[ -f ~/.zlocal ]]      && source ~/.zlocal
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# mise: tool versions, per-directory [env] / _.path, uv venv activation, hooks.
# Kept LAST so its paths sit in front of everything above and project pins win.
# 'mise activate zsh' is the guard string the kitting scripts grep for.
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
