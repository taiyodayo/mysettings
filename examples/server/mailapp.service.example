# Example only: adapt app command/account/paths; never installed by machine setup.
[Unit]
Description=Example Bundler application
After=network.target

[Service]
User=mailapp
Group=mailapp
WorkingDirectory=/srv/mailapp/current
Environment=HOME=/home/mailapp
Environment=RAILS_ENV=production
Environment=RACK_ENV=production
Environment=PATH=/home/mailapp/.local/share/mise/installs/ruby/3.4.12/bin:/usr/bin:/bin
Environment=BUNDLE_FROZEN=true
ExecStart=/home/mailapp/.local/share/mise/installs/ruby/3.4.12/bin/bundle exec puma -C config/puma.rb
Restart=on-failure

[Install]
WantedBy=multi-user.target
